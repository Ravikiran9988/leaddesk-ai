# AI LeadDesk Mini - Root Environment Template

# Server Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/ai-leaddesk-mini
JWT_SECRET=your_super_secret_jwt_key_here

# Groq AI API Key (Get free API key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Client URL
CLIENT_URL=http://localhost:5173

# Optional Cloudinary (for file attachment uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional Email SMTP (for Nodemailer notifications)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="AI LeadDesk" <no-reply@leaddesk.com>
ADMIN_EMAIL=admin@leaddesk.com
